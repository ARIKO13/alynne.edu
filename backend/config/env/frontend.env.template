# Frontend Environment Variables (lina-learning)
# Copy to frontend/.env and fill with real values

# App
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Auth
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# AI APIs
GATEWAY_API_KEY=gw_sk_your-key
GROQ_API_KEY=gsk_your-key
GROQ_PDF_KEY=gsk_your-pdf-key
GROQ_API_KEY_STT=gsk_your-stt-key
GROQ_API_KEY_PDF=gsk_your-pdf-key

# Cloudflare D1 Database
CF_API_TOKEN=cfut_your-token
CF_ACCOUNT_ID=your-account-id
CF_DATABASE_ID=your-database-id
