# Backend Environment Variables (whisper-backend)
# These are set via ecosystem.config.cjs env section

# Changed from large-v3-turbo to tiny (2026-09-14).
# tiny is for voice command only — main STT now uses Groq Whisper API.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
CHUNK_MINUTES=1
CHUNK_COOLDOWN=0.5

QWEN_MODEL_PATH=/root/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
QWEN_N_CTX=4096
QWEN_N_THREADS=4
QWEN_N_GPU_LAYERS=0

MAX_QUEUE_SIZE=10
JOB_TTL_SECONDS=7200
IDLE_TIMEOUT=300

TF_CPP_MIN_LOG_LEVEL=3
HF_HOME=/root/.cache/huggingface
