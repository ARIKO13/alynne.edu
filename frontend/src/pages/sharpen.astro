---
import Layout from '@/layouts/Layout.astro';
import '@/styles/global.css';
import { ImageSharpener } from '@/components/image-sharpener';
---

<Layout title="Penajam Gambar - ALYNNE AI">
  <main class="min-h-screen bg-[#09090b] pt-24 pb-16 px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Header -->
      <div class="mb-8 text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-4 py-1.5 mb-4">
          <svg class="h-3.5 w-3.5 text-[#8B5CF6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l14 9-14 9V3z"/></svg>
          <span class="text-xs text-zinc-400">Computer Vision Tool</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-2">
          Penajam <span class="bg-gradient-to-r from-[#8B5CF6] to-purple-400 bg-clip-text text-transparent">Gambar</span>
        </h1>
        <p class="text-sm text-zinc-500 max-w-lg mx-auto leading-relaxed">
          Auto-detect blur pake Laplacian variance, terus tajamin pake convolution kernel atau unsharp masking.
          Semua dijalankan di browser — gambar ga pernah ke server.
        </p>
      </div>

      <!-- Sharpener component -->
      <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-5 sm:p-6">
        <ImageSharpener client:load />
      </div>

      <!-- Feature cards -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#8B5CF6]/15 mb-2">
            <svg class="h-4 w-4 text-[#8B5CF6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <p class="text-xs font-semibold text-zinc-200">Real-time</p>
          <p class="text-[10px] text-zinc-500 mt-1">Convolution dijalankan langsung di Canvas API — instant feedback, no upload.</p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/15 mb-2">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
          </div>
          <p class="text-xs font-semibold text-zinc-200">4 Metode CV</p>
          <p class="text-[10px] text-zinc-500 mt-1">Sharpen, Strong Sharpen, Edge Enhance, Unsharp Masking — pilih sesuai jenis gambar.</p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-500/15 mb-2">
            <svg class="h-4 w-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <p class="text-xs font-semibold text-zinc-200">Auto Blur Detection</p>
          <p class="text-[10px] text-zinc-500 mt-1">Laplacian variance ngitung score blur — sistem rekomendasi intensity otomatis.</p>
        </div>
      </div>

      <!-- Back link -->
      <div class="mt-8 text-center">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-zinc-300 transition-colors">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Kembali ke beranda
        </a>
      </div>
    </div>
  </main>
</Layout>
