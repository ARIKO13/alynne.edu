---
import Layout from '@/layouts/Layout.astro';
import '@/styles/global.css';
---

<Layout title="ALYNNE AI">
  <main class="min-h-screen bg-[var(--bg)] px-6 pt-24 pb-20">
    <div class="max-w-6xl mx-auto grid md:grid-cols-[7fr_5fr] gap-10 items-end">
      <div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white mb-5 max-w-xl">
          Semua kebutuhan belajar, satu tempat.
        </h1>

        <p class="text-base text-zinc-400 max-w-lg leading-relaxed mb-8">
          Ubah materi jadi rangkuman, kuis, dan flashcard. Cukup unggah file
          atau tempel tautan YouTube.
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-3">
          <a
            href="/about"
            class="inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-semibold text-white bg-[var(--accent)] hover:bg-[var(--accent-hover)] transition-colors focus-visible:outline-white"
          >
            Mulai belajar
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="/billing"
            class="inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-semibold text-zinc-200 bg-[var(--surface)] hover:bg-[var(--surface-2)] border border-[var(--border)] transition-colors"
          >
            Lihat paket
          </a>
        </div>
      </div>

      <div class="hidden md:block">
        <p class="text-sm text-zinc-500 leading-relaxed max-w-xs">
          Rangkuman otomatis, kuis, flashcard, transkripsi audio, dan pemecah
          soal — dikerjakan agen yang sama, tanpa pindah aplikasi.
        </p>
      </div>
    </div>
  </main>

  <footer class="border-t border-[var(--border)] py-6 px-6">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <span class="text-[11px] text-zinc-500">Povycon Technology</span>
      <a href="/privacy" class="text-[11px] text-zinc-500 hover:text-zinc-300">Privacy Policy</a>
      <span class="text-[11px] text-zinc-500">{new Date().getFullYear()}</span>
    </div>
  </footer>
</Layout>
