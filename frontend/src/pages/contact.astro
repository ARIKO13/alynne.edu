---
import Layout from '@/layouts/Layout.astro';
import '@/styles/global.css';
---

<Layout title="Contact - ALYNNE AI">
  <main class="min-h-screen bg-[var(--bg)] pt-24 pb-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-3">
          Hubungi kami
        </h1>
        <p class="text-sm text-zinc-500 max-w-md mx-auto">
          Punya pertanyaan atau ingin bekerja sama? Hubungi kami melalui sosial media berikut.
        </p>
      </div>

      <div class="max-w-md mx-auto">
        <div class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-8 text-center">
          <!-- Logo Instagram (aset brand: gradient resmi Instagram, satu-satunya
               gradien di halaman ini — avoid-ai-design-ignore: C1) -->
          <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-sky-500 via-pink-500 to-orange-400 flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </div>

          <h2 class="text-lg font-semibold text-white mb-2">Instagram</h2>
          <p class="text-sm text-zinc-500 mb-6">
            Follow kami untuk update terbaru, tips, dan informasi seputar ALYNNE AI.
          </p>

          <a
            href="https://instagram.com/alynne.ai"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-semibold text-white bg-[var(--accent)] hover:bg-[var(--accent-hover)] transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            @alynne.ai
          </a>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/" class="text-sm text-zinc-500 hover:text-white transition-colors">
          &larr; Kembali ke beranda
        </a>
      </div>
    </div>
  </main>
</Layout>
