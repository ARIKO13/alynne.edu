---
import Layout from '@/layouts/Layout.astro';
import '@/styles/global.css';
---

<Layout title="Manual Input - LINA.LEARNING">
  <div class="min-h-screen bg-background">
    <!-- Header -->
    <header class="border-b border-border px-4 py-3 flex items-center gap-3">
      <a href="/" class="text-muted-foreground hover:text-foreground transition-colors text-sm">← Kembali</a>
      <div class="h-4 w-px bg-border"></div>
      <h1 class="text-sm font-medium">Manual Input</h1>
      <span class="text-xs text-muted-foreground ml-auto">Tanpa API - parser lokal</span>
    </header>

    <!-- Main two-panel layout -->
    <div class="flex flex-col lg:flex-row h-[calc(100vh-49px)]">
      <!-- LEFT PANEL: Input -->
      <div class="w-full lg:w-1/2 border-r border-border flex flex-col">
        <!-- Input toolbar -->
        <div class="flex items-center gap-2 px-4 py-2 border-b border-border">
          <button id="btn-parse" class="px-4 py-1.5 bg-primary text-primary-foreground text-sm font-medium rounded-md hover:opacity-90 transition-opacity disabled:opacity-50" disabled>
            Parse
          </button>
          <button id="btn-clear" class="px-3 py-1.5 text-sm text-muted-foreground hover:text-foreground border border-border rounded-md transition-colors">
            Clear
          </button>
          <button id="btn-example" class="px-3 py-1.5 text-sm text-muted-foreground hover:text-foreground border border-border rounded-md transition-colors">
            Contoh
          </button>
        </div>

        <!-- Formatting guide (collapsible) -->
        <details class="border-b border-border">
          <summary class="px-4 py-2 text-xs text-muted-foreground cursor-pointer hover:text-foreground select-none">
            Panduan format ↓
          </summary>
          <div class="px-4 pb-3 text-xs text-muted-foreground space-y-1 bg-secondary/30">
            <p><code class="text-primary"># Judul</code> → Judul modul</p>
            <p><code class="text-primary">## Bab</code> → Kegiatan pembelajaran baru</p>
            <p><code class="text-primary">### Sub</code> → Sub-judul dalam kegiatan</p>
            <p><code class="text-primary">- item</code> → Daftar (tujuan / materi)</p>
            <p><code class="text-primary">> teks</code> → Kutipan (stimulus / pendahuluan)</p>
            <p><code class="text-primary">| h1 | h2 |</code> → Tabel</p>
            <p><code class="text-primary">```code```</code> → Blok kode</p>
            <p><code class="text-primary">---</code> → Pemisah (dihilangkan)</p>
            <p class="pt-1 border-t border-border mt-1">List <code class="text-primary">-</code> sebelum <code class="text-primary">##</code> pertama → tujuan pembelajaran.</p>
            <p>Bab <code class="text-primary">## Rangkuman</code> atau <code class="text-primary">## Kesimpulan</code> → rangkuman akhir.</p>
          </div>
        </details>

        <!-- Textarea -->
        <textarea
          id="input-text"
          class="flex-1 w-full p-4 bg-transparent text-foreground text-sm resize-none outline-none placeholder:text-muted-foreground/50 font-mono leading-relaxed"
          placeholder="Ketik atau tempel teks di sini...&#10;&#10;# Judul Modul&#10;&#10;> Pendahuluan modul di sini.&#10;&#10;- Tujuan pertama&#10;- Tujuan kedua&#10;&#10;## Kegiatan 1&#10;&#10;> Stimulus atau pertanyaan pemantik.&#10;&#10;Paragraf materi pertama.&#10;&#10;- Poin materi A&#10;- Poin materi B&#10;&#10;## Rangkuman&#10;&#10;- Rangkuman poin 1&#10;- Rangkuman poin 2"
          spellcheck="false"
        ></textarea>
      </div>

      <!-- RIGHT PANEL: Preview -->
      <div class="w-full lg:w-1/2 flex flex-col">
        <!-- Preview toolbar -->
        <div class="flex items-center gap-2 px-4 py-2 border-b border-border">
          <span class="text-sm font-medium">Preview</span>
          <div class="flex-1"></div>
          <button id="btn-download-pdf" class="px-4 py-1.5 bg-primary text-primary-foreground text-sm font-medium rounded-md hover:opacity-90 transition-opacity disabled:opacity-50 hidden">
            Download PDF
          </button>
          <button id="btn-view-json" class="px-3 py-1.5 text-sm text-muted-foreground hover:text-foreground border border-border rounded-md transition-colors hidden">
            JSON
          </button>
        </div>

        <!-- Preview content -->
        <div id="preview-area" class="flex-1 overflow-y-auto p-6">
          <div id="preview-empty" class="flex items-center justify-center h-full text-muted-foreground text-sm">
            <div class="text-center space-y-2">
              <p>Belum ada data.</p>
              <p class="text-xs">Ketik teks di panel kiri, lalu klik <strong>Parse</strong>.</p>
            </div>
          </div>
          <div id="preview-content" class="hidden space-y-6 text-sm leading-relaxed"></div>
          <div id="preview-json" class="hidden">
            <pre id="json-pre" class="text-xs font-mono text-muted-foreground whitespace-pre-wrap break-words bg-secondary/30 p-4 rounded-md border border-border max-h-full overflow-auto"></pre>
          </div>
        </div>

        <!-- Loading overlay -->
        <div id="loading-overlay" class="hidden absolute inset-0 bg-background/80 flex items-center justify-center z-10">
          <div class="text-sm text-muted-foreground">Parsing...</div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const inputText = document.getElementById('input-text') as HTMLTextAreaElement;
  const btnParse = document.getElementById('btn-parse') as HTMLButtonElement;
  const btnClear = document.getElementById('btn-clear') as HTMLButtonElement;
  const btnExample = document.getElementById('btn-example') as HTMLButtonElement;
  const btnDownloadPdf = document.getElementById('btn-download-pdf') as HTMLButtonElement;
  const btnViewJson = document.getElementById('btn-view-json') as HTMLButtonElement;
  const previewEmpty = document.getElementById('preview-empty')!;
  const previewContent = document.getElementById('preview-content')!;
  const previewJson = document.getElementById('preview-json')!;
  const jsonPre = document.getElementById('json-pre') as HTMLPreElement;
  const loadingOverlay = document.getElementById('loading-overlay')!;

  let parsedData: any = null;
  let showJson = false;

  // Enable parse button when there's text
  inputText.addEventListener('input', () => {
    btnParse.disabled = !inputText.value.trim();
  });

  // Example text
  const EXAMPLE = `# Pengenalan UI/UX Design

> Modul ini membahas dasar-dasar User Interface dan User Experience Design, termasuk prinsip desain yang baik dan tools yang digunakan industri.

- Memahami perbedaan UI dan UX
- Mengenal prinsip desain yang efektif
- Mampu menggunakan Figma untuk wireframing
- Memahami proses user research

## Perbedaan UI dan UX

> Apa perbedaan antara UI dan UX? Mengapa keduanya sama pentingnya?

User Interface (UI) berkaitan dengan tampilan visual dari sebuah produk digital. Ini mencakup layout, warna, tipografi, dan elemen visual lainnya yang dilihat pengguna.

User Experience (UX) lebih luas - mencakup keseluruhan pengalaman pengguna saat berinteraksi dengan produk, termasuk kemudahan penggunaan, aksesibilitas, dan kepuasan.

- UI fokus pada **tampilan**, UX fokus pada **pengalaman**
- UI adalah bagian dari UX
- Keduanya harus bekerja sama untuk produk yang baik

| Aspek | UI | UX |
|---|---|---|
| Fokus | Visual | Pengalaman |
| Skill | Desain grafis | Riset & psikologi |
| Output | Mockup | User flow |

## Prinsip Desain

> Prinsip desain membantu kita membuat antarmuka yang intuitif dan menarik.

Beberapa prinsip desain yang penting dalam UI/UX:

- **Hierarki Visual**: Menyusun elemen berdasarkan tingkat kepentingan
- **Konsistensi**: Menggunakan pola yang sama di seluruh aplikasi
- **Aksesibilitas**: Memastikan semua pengguna bisa menggunakan produk
- **Feedback**: Memberikan respons atas setiap aksi pengguna

Menurut Don Norman, ada 4 prinsip desain utama: discoverability, feedback, conceptual models, dan affordances.

Discoverability adalah kemudahan menemukan fitur dalam antarmuka.

Tools utama yang digunakan: Figma, Canva, dan Sketch.

## Proses Desain dengan Figma

> Figma adalah tool kolaboratif yang paling banyak digunakan designer saat ini.

Langkah-langkah dasar menggunakan Figma:

- Buat frame dengan ukuran yang sesuai (mobile: 375x812, desktop: 1440x1024)
- Gunakan Auto Layout untuk mengatur elemen
- Buat component untuk elemen yang berulang
- Gunakan prototype untuk membuat interaksi

Auto Layout memudahkan responsive design.

## Rangkuman

- UI dan UX adalah dua aspek berbeda namun saling melengkapi
- Prinsip desain seperti hierarki visual dan konsistensi sangat penting
- Figma menjadi tools utama industri desain saat ini
- Proses desain meliputi wireframing, prototyping, dan testing
- Aksesibilitas dan feedback adalah kunci pengalaman pengguna yang baik`;

  btnExample.addEventListener('click', () => {
    inputText.value = EXAMPLE;
    btnParse.disabled = false;
    inputText.focus();
  });

  btnClear.addEventListener('click', () => {
    inputText.value = '';
    btnParse.disabled = true;
    parsedData = null;
    previewEmpty.classList.remove('hidden');
    previewContent.classList.add('hidden');
    previewJson.classList.add('hidden');
    btnDownloadPdf.classList.add('hidden');
    btnViewJson.classList.add('hidden');
  });

  // Parse button
  btnParse.addEventListener('click', async () => {
    const text = inputText.value.trim();
    if (!text) return;

    btnParse.disabled = true;
    btnParse.textContent = 'Parsing...';
    loadingOverlay.classList.remove('hidden');

    try {
      const res = await fetch('/api/manual-parse', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Unknown error' }));
        alert('Error: ' + (err.error || res.statusText));
        return;
      }

      parsedData = await res.json();
      renderPreview(parsedData);
      btnDownloadPdf.classList.remove('hidden');
      btnViewJson.classList.remove('hidden');
    } catch (e: any) {
      alert('Gagal: ' + (e.message || e));
    } finally {
      btnParse.disabled = false;
      btnParse.textContent = 'Parse';
      loadingOverlay.classList.add('hidden');
    }
  });

  // JSON toggle
  btnViewJson.addEventListener('click', () => {
    showJson = !showJson;
    if (showJson) {
      previewContent.classList.add('hidden');
      previewJson.classList.remove('hidden');
      previewEmpty.classList.add('hidden');
      jsonPre.textContent = JSON.stringify(parsedData, null, 2);
      btnViewJson.textContent = 'Preview';
    } else {
      previewContent.classList.remove('hidden');
      previewJson.classList.add('hidden');
      btnViewJson.textContent = 'JSON';
    }
  });

  // Download PDF
  btnDownloadPdf.addEventListener('click', async () => {
    if (!parsedData) return;
    btnDownloadPdf.disabled = true;
    btnDownloadPdf.textContent = 'Generating...';

    try {
      const { generatePdf } = await import('@/lib/pdf-generator');
      const pdfData = {
        ...parsedData,
        date: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }),
        totalChars: inputText.value.length,
        materialCount: 0,
        branding: 'LINA.LEARNING',
      };
      await generatePdf(pdfData);
    } catch (e: any) {
      alert('Gagal membuat PDF: ' + (e.message || e));
    } finally {
      btnDownloadPdf.disabled = false;
      btnDownloadPdf.textContent = 'Download PDF';
    }
  });

  // ── Render preview HTML ──
  function renderPreview(data: any) {
    previewEmpty.classList.add('hidden');
    previewContent.classList.remove('hidden');
    if (showJson) {
      jsonPre.textContent = JSON.stringify(data, null, 2);
    }

    let html = '';

    // Title
    html += `<div class="border-b border-border pb-4">
      <h1 class="text-xl font-bold text-foreground">${esc(data.title)}</h1>
      <p class="text-xs text-muted-foreground mt-1">${esc(data.identitas?.mataPelajaran || 'Umum')} · ${esc(data.identitas?.kelas || '-')}</p>
    </div>`;

    // Pendahuluan
    if (data.pendahuluan) {
      html += `<div>
        <h2 class="text-sm font-semibold text-primary mb-2">Pendahuluan</h2>
        <p class="text-muted-foreground">${esc(data.pendahuluan)}</p>
      </div>`;
    }

    // Tujuan Pembelajaran
    if (data.tujuanPembelajaran?.length) {
      html += `<div>
        <h2 class="text-sm font-semibold text-primary mb-2">Tujuan pembelajaran</h2>
        <ul class="space-y-1">
          ${data.tujuanPembelajaran.map((t: string) => `<li class="flex gap-2 text-muted-foreground"><span class="text-primary mt-0.5">•</span><span>${esc(t)}</span></li>`).join('')}
        </ul>
      </div>`;
    }

    // Kegiatan Pembelajaran
    if (data.kegiatanPembelajaran?.length) {
      html += `<div class="space-y-6">`;
      html += `<h2 class="text-sm font-semibold text-primary">Kegiatan pembelajaran</h2>`;

      for (const kg of data.kegiatanPembelajaran) {
        html += `<div class="bg-secondary/30 rounded-lg p-4 border border-border">`;
        html += `<h3 class="font-semibold text-foreground mb-2">${esc(kg.title)}</h3>`;

        if (kg.stimulus) {
          html += `<blockquote class="border-l-2 border-primary pl-3 text-muted-foreground italic text-xs mb-3">${esc(kg.stimulus)}</blockquote>`;
        }

        if (kg.materi?.length) {
          html += `<div class="space-y-2">`;
          for (const m of kg.materi) {
            // Check if it's a table
            if (m.includes('|') && m.includes('\n')) {
              html += renderTable(m);
            } else {
              html += `<p class="text-muted-foreground">${esc(m)}</p>`;
            }
          }
          html += `</div>`;
        }

        if (kg.steps?.length) {
          html += `<div class="mt-3"><h4 class="text-xs font-semibold text-foreground mb-1">Langkah:</h4>
            <ol class="space-y-1 text-muted-foreground">${kg.steps.map((s: string, i: number) => `<li><span class="text-primary font-mono mr-1">${i + 1}.</span>${esc(s)}</li>`).join('')}</ol></div>`;
        }

        if (kg.reviewNotes?.length) {
          html += `<div class="mt-3 bg-yellow-500/10 border border-yellow-500/20 rounded p-2 text-xs text-yellow-200/80"><strong>Catatan Review:</strong><ul class="mt-1 space-y-0.5">${kg.reviewNotes.map((r: string) => `<li>• ${esc(r)}</li>`).join('')}</ul></div>`;
        }

        html += `</div>`;
      }
      html += `</div>`;
    }

    // Rangkuman Akhir
    if (data.rangkumanAkhir?.length) {
      html += `<div class="bg-primary/5 border border-primary/20 rounded-lg p-4">
        <h2 class="text-sm font-semibold text-primary mb-2">Rangkuman akhir</h2>
        <ul class="space-y-1">
          ${data.rangkumanAkhir.map((r: string) => `<li class="flex gap-2 text-muted-foreground"><span class="text-primary mt-0.5">✓</span><span>${esc(r)}</span></li>`).join('')}
        </ul>
      </div>`;
    }

    // Entitas Penting
    const ep = data.entitasPenting;
    const hasEntities = ep && (ep.tools?.length || ep.namaOrang?.length || ep.angkaAturan?.length || ep.istilahTeknis?.length || ep.kodeRumus?.length);
    if (hasEntities) {
      html += `<div>
        <h2 class="text-sm font-semibold text-primary mb-2">Entitas penting</h2>
        <div class="grid grid-cols-2 gap-2 text-xs">`;

      if (ep.tools?.length) html += entityCard('Tools', ep.tools);
      if (ep.namaOrang?.length) html += entityCard('Nama', ep.namaOrang);
      if (ep.angkaAturan?.length) html += entityCard('Angka/Aturan', ep.angkaAturan);
      if (ep.istilahTeknis?.length) html += entityCard('Istilah', ep.istilahTeknis);
      if (ep.kodeRumus?.length) html += entityCard('Kode/Rumus', ep.kodeRumus);

      html += `</div></div>`;
    }

    previewContent.innerHTML = html;
  }

  function renderTable(tableText: string): string {
    const lines = tableText.split('\n');
    if (lines.length < 2) return `<p class="text-muted-foreground">${esc(tableText)}</p>`;

    let html = '<div class="overflow-x-auto my-2"><table class="w-full text-xs border border-border rounded">';
    for (let i = 0; i < lines.length; i++) {
      const cells = lines[i].split('|').map(c => c.trim()).filter(Boolean);
      const tag = i === 0 ? 'th' : 'td';
      const cls = i === 0
        ? 'bg-secondary text-foreground font-semibold'
        : 'text-muted-foreground border-t border-border';
      html += `<tr class="${cls}">${cells.map(c => `<${tag} class="px-2 py-1 text-left">${esc(c)}</${tag}>`).join('')}</tr>`;
    }
    html += '</table></div>';
    return html;
  }

  function entityCard(label: string, items: string[]): string {
    return `<div class="bg-secondary/50 rounded p-2 border border-border">
      <div class="font-semibold text-foreground mb-1">${label}</div>
      <div class="flex flex-wrap gap-1">${items.map((i: string) => `<span class="bg-primary/10 text-primary px-1.5 py-0.5 rounded text-[10px]">${esc(i)}</span>`).join('')}</div>
    </div>`;
  }

  function esc(str: string): string {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }
</script>
