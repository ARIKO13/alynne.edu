---
import { parseManualInput } from '@/lib/parser';
import type { APIRoute } from 'astro';

export const POST: APIRoute = async ({ request }) => {
  try {
    const body = await request.json();
    const text: string = body?.text;

    if (!text || typeof text !== 'string' || text.trim().length === 0) {
      return Response.json(
        { error: 'Text kosong. Silakan masukkan teks untuk di-parse.' },
        { status: 400 },
      );
    }

    const result = parseManualInput(text);
    return Response.json(result);
  } catch (err: any) {
    console.error('[manual-parse] Error:', err);
    return Response.json(
      { error: err?.message || 'Gagal mem-parse teks.' },
      { status: 500 },
    );
  }
};
---
