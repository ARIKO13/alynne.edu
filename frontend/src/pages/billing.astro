---
import Layout from '@/layouts/Layout.astro';
import '@/styles/global.css';
import { BillingFlow } from '@/components/billing-flow';
import { BILLING_TIERS, formatIDR } from '@/lib/billing-models';
---

<Layout title="Billing - ALYNNE AI">
  <main class="min-h-screen bg-[#09090b] pt-24 pb-16 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-8 text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-4 py-1.5 mb-4">
          <svg class="h-3.5 w-3.5 text-[#8B5CF6]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><path d="M17 21v-5h-5v5"/><path d="M9 21v-5H4v5"/></svg>
          <span class="text-xs text-zinc-400">Langganan ALYNNE.AI</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-2">
          Pilih model <span class="bg-gradient-to-r from-[#8B5CF6] to-purple-400 bg-clip-text text-transparent">yang sesuai</span>
        </h1>
        <p class="text-sm text-zinc-500 max-w-lg mx-auto leading-relaxed">
          Pilih tier, lihat nominal, pilih metode pembayaran, lalu checkout. Semua dalam satu halaman.
        </p>
      </div>

      <!-- 3-Step Billing Flow (React) -->
      <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] p-5 sm:p-6">
        <BillingFlow client:load />
      </div>

      <!-- Trust footer -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
        <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-3">
          <p class="text-[10px] uppercase tracking-wide text-zinc-500 mb-1">Pembayaran</p>
          <p class="text-xs font-medium text-zinc-300">Midtrans Snap</p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-3">
          <p class="text-[10px] uppercase tracking-wide text-zinc-500 mb-1">Enkripsi</p>
          <p class="text-xs font-medium text-zinc-300">End-to-end</p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-3">
          <p class="text-[10px] uppercase tracking-wide text-zinc-500 mb-1">Pajak</p>
          <p class="text-xs font-medium text-zinc-300">PPN 11% incl.</p>
        </div>
        <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-3">
          <p class="text-[10px] uppercase tracking-wide text-zinc-500 mb-1">Support</p>
          <p class="text-xs font-medium text-zinc-300">24/7</p>
        </div>
      </div>

      <!-- Back to home -->
      <div class="mt-8 text-center">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-zinc-300 transition-colors">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Kembali ke beranda
        </a>
      </div>
    </div>
  </main>
</Layout>
