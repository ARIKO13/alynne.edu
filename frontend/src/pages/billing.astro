---
import Layout from '@/layouts/Layout.astro';
import '@/styles/global.css';
import { BillingFlow } from '@/components/billing-flow';
import { BILLING_TIERS, formatIDR } from '@/lib/billing-models';
---

<Layout title="Billing - ALYNNE AI">
  <main class="min-h-screen bg-[var(--bg)] pt-24 pb-16 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-2">
          Pilih model yang sesuai
        </h1>
        <p class="text-sm text-zinc-500 max-w-lg leading-relaxed">
          Pilih tier, lihat nominal, pilih metode pembayaran, lalu checkout. Semua dalam satu halaman.
        </p>
      </div>

      <!-- 3-Step Billing Flow (React) -->
      <div class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 sm:p-6">
        <BillingFlow client:load />
      </div>

      <!-- Fakta pembayaran -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-md border border-[var(--border)] bg-[var(--surface)] p-3">
          <p class="text-[11px] text-zinc-500 mb-1">Pembayaran</p>
          <p class="text-xs font-medium text-zinc-300">Midtrans Snap</p>
        </div>
        <div class="rounded-md border border-[var(--border)] bg-[var(--surface)] p-3">
          <p class="text-[11px] text-zinc-500 mb-1">Metode</p>
          <p class="text-xs font-medium text-zinc-300">QRIS, VA, e-wallet</p>
        </div>
        <div class="rounded-md border border-[var(--border)] bg-[var(--surface)] p-3">
          <p class="text-[11px] text-zinc-500 mb-1">Pajak</p>
          <p class="text-xs font-medium text-zinc-300">PPN 11% termasuk</p>
        </div>
        <div class="rounded-md border border-[var(--border)] bg-[var(--surface)] p-3">
          <p class="text-[11px] text-zinc-500 mb-1">Bantuan</p>
          <p class="text-xs font-medium text-zinc-300">DM Instagram @alynne.ai</p>
        </div>
      </div>

      <!-- Back to home -->
      <div class="mt-8">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-zinc-300 transition-colors">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Kembali ke beranda
        </a>
      </div>
    </div>
  </main>
</Layout>
