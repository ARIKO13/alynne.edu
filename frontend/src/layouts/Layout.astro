---
interface Props {
  title?: string;
  showNavbar?: boolean;
}

const { title = 'ALYNNE AI', showNavbar = true } = Astro.props;
import Navbar from '@/components/Navbar.astro';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ALYNNE AI — Belajar Sambil Main, Raih Sertifikat!" />
    <link rel="icon" type="image/png" href="/alynne-ai-logo.png" />

    <!-- Display face untuk headline (DESIGN.md §6, ronde 3) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&display=swap"
    />

    <title>{title}</title>

    <!-- Pre-apply theme class BEFORE hydration to prevent dark-mode flash.
         The Zustand store at 'lina-learning-v2' persists `theme` in
         state.theme. We read it from localStorage directly here. -->
    <script is:inline>
      try {
        const persisted = JSON.parse(localStorage.getItem('lina-learning-v2') || '{}');
        const theme = (persisted?.state?.theme) || 'dark';
        if (theme === 'light') document.documentElement.classList.add('light');
      } catch (e) {}
    </script>
  </head>
  <body class="antialiased bg-[var(--bg)] text-[var(--text)]">
    {showNavbar && <Navbar />}
    <slot />
  </body>
</html>
