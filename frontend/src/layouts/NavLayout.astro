---
interface Props {
  title?: string;
}

const { title = 'ALYNNE AI' } = Astro.props;
import Navbar from '@/components/Navbar.astro';
import '@/styles/global.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="One agent for all skills." />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
  </head>
  <body class="antialiased bg-[#050507] text-foreground">
    <Navbar />
    <main>
      <slot />
    </main>
  </body>
</html>
