/**
 * MediaUpload — Upload audio/video untuk transkripsi
 * - Support semua format audio: mp3, wav, m4a, ogg, flac, opus, aac, webm
 * - Support semua format video: mp4, mkv, avi, mov, flv, wmv, mpg, mpeg, ts, m4v, 3gp
 * - Auto-chunk 15 menit untuk file panjang (server-side)
 * - Progress bar realtime
 * - Drag & drop support
 */
import { useState, useRef, useCallback } from "react";
import { Button } from "@/components/ui/button";
import { Progress } from "@/components/ui/progress";
import { Upload, FileAudio, FileVideo, X, Loader2, AlertCircle, CheckCircle2 } from "lucide-react";
import { toast } from "sonner";
import { cn } from "@/lib/utils";

// No file size limit — unlimited upload (server handles chunking)

const ACCEPTED_FORMATS = {
  audio: [".mp3", ".wav", ".m4a", ".aac", ".ogg", ".flac", ".opus", ".webm"],
  video: [".mp4", ".mkv", ".avi", ".mov", ".flv", ".wmv", ".webm", ".mpg", ".mpeg", ".ts", ".m4v", ".3gp"],
};

interface MediaUploadProps {
  onTranscript: (text: string, meta: { duration: number; processingTime: number; chunks: number; model: string }) => void;
  disabled?: boolean;
}

interface UploadState {
  status: "idle" | "uploading" | "processing" | "done" | "error";
  progress: number;
  fileName: string;
  fileSize: number;
  errorMsg?: string;
}

export function MediaUpload({ onTranscript, disabled }: MediaUploadProps) {
  const [state, setState] = useState<UploadState>({
    status: "idle",
    progress: 0,
    fileName: "",
    fileSize: 0,
  });
  const [isDragging, setIsDragging] = useState(false);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const xhrRef = useRef<XMLHttpRequest | null>(null);

  const isVideo = (filename: string) => {
    const ext = "." + filename.split(".").pop()?.toLowerCase();
    return ACCEPTED_FORMATS.video.includes(ext);
  };

  const formatSize = (bytes: number) => {
    if (bytes < 1024) return bytes + " B";
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
    if (bytes < 1024 * 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + " MB";
    return (bytes / 1024 / 1024 / 1024).toFixed(2) + " GB";
  };

  const formatTime = (sec: number) => {
    if (sec < 60) return sec.toFixed(1) + "s";
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m}m ${s}s`;
  };

  const handleFile = useCallback(async (file: File) => {
    if (disabled) return;

    const ext = "." + file.name.split(".").pop()?.toLowerCase();
    const isAudio = ACCEPTED_FORMATS.audio.includes(ext);
    const isVid = ACCEPTED_FORMATS.video.includes(ext);

    if (!isAudio && !isVid) {
      toast.error(`Format tidak didukung: ${ext}`);
      return;
    }

    setState({
      status: "uploading",
      progress: 0,
      fileName: file.name,
      fileSize: file.size,
    });

    try {
      const formData = new FormData();
      formData.append("file", file);
      formData.append("language", "id");
      formData.append("chunk_mode", "auto");

      // Use XHR for progress tracking
      const xhr = new XMLHttpRequest();
      xhrRef.current = xhr;

      xhr.upload.onprogress = (e) => {
        if (e.lengthComputable) {
          const pct = (e.loaded / e.total) * 50; // 0-50% is upload
          setState((s) => ({ ...s, progress: pct }));
        }
      };

      xhr.onload = () => {
        if (xhr.status === 200) {
          try {
            const data = JSON.parse(xhr.responseText);
            setState((s) => ({
              ...s,
              status: "done",
              progress: 100,
            }));

            const text = data.text || "";
            if (text) {
              onTranscript(text, {
                duration: data.duration || 0,
                processingTime: data.processing_time || 0,
                chunks: data.chunk_count || 1,
                model: data.model || "large-v3-turbo",
              });
              toast.success(`Transkripsi selesai! ${text.length} karakter${data.chunked ? ` (${data.chunk_count} chunk)` : ""}`);
            } else {
              toast.error("Tidak ada teks terdeteksi dalam audio/video");
            }
          } catch (e) {
            setState((s) => ({ ...s, status: "error", errorMsg: "Invalid response" }));
            toast.error("Response tidak valid dari server");
          }
        } else {
          let errMsg = `HTTP ${xhr.status}`;
          try {
            const errData = JSON.parse(xhr.responseText);
            errMsg = errData.error || errMsg;
          } catch {}
          setState((s) => ({ ...s, status: "error", errorMsg: errMsg }));
          toast.error(`Transkripsi gagal: ${errMsg}`);
        }
      };

      xhr.onerror = () => {
        setState((s) => ({ ...s, status: "error", errorMsg: "Network error" }));
        toast.error("Network error saat upload");
      };

      // Update progress to "processing" phase
      setState((s) => ({ ...s, status: "processing", progress: 50 }));

      xhr.open("POST", "/api/whisper/transcribe");
      xhr.send(formData);

    } catch (e) {
      setState((s) => ({
        ...s,
        status: "error",
        errorMsg: e instanceof Error ? e.message : "Unknown error",
      }));
      toast.error(`Error: ${e instanceof Error ? e.message : "unknown"}`);
    }
  }, [disabled, onTranscript]);

  const onFileInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) handleFile(file);
    e.target.value = ""; // reset
  };

  const onDrop = useCallback((e: React.DragEvent) => {
    e.preventDefault();
    setIsDragging(false);
    if (disabled) return;
    const file = e.dataTransfer.files?.[0];
    if (file) handleFile(file);
  }, [disabled, handleFile]);

  const onDragOver = (e: React.DragEvent) => {
    e.preventDefault();
    if (!disabled) setIsDragging(true);
  };

  const onDragLeave = () => setIsDragging(false);

  const cancelUpload = () => {
    if (xhrRef.current) {
      xhrRef.current.abort();
      xhrRef.current = null;
    }
    setState({ status: "idle", progress: 0, fileName: "", fileSize: 0 });
  };

  const reset = () => {
    setState({ status: "idle", progress: 0, fileName: "", fileSize: 0 });
  };

  // Disabled state
  if (disabled && state.status === "idle") {
    return (
      <div className="rounded-lg border border-white/[0.06] bg-white/[0.02] p-4 opacity-50">
        <div className="flex items-center gap-2 text-xs text-zinc-500">
          <Upload className="h-4 w-4" />
          <span>Upload media (disabled while recording)</span>
        </div>
      </div>
    );
  }

  // Idle state — show dropzone
  if (state.status === "idle") {
    return (
      <div
        onDrop={onDrop}
        onDragOver={onDragOver}
        onDragLeave={onDragLeave}
        onClick={() => fileInputRef.current?.click()}
        className={cn(
          "rounded-lg border-2 border-dashed p-4 cursor-pointer transition-all",
          isDragging
            ? "border-[#8B5CF6] bg-[#8B5CF6]/10"
            : "border-white/[0.08] bg-white/[0.02] hover:border-white/[0.15] hover:bg-white/[0.04]"
        )}
      >
        <input
          ref={fileInputRef}
          type="file"
          accept={[...ACCEPTED_FORMATS.audio, ...ACCEPTED_FORMATS.video].join(",")}
          onChange={onFileInputChange}
          className="hidden"
        />
        <div className="flex items-center gap-3">
          <div className="flex h-10 w-10 items-center justify-center rounded-lg bg-[#8B5CF6]/15">
            <Upload className="h-5 w-5 text-[#8B5CF6]" />
          </div>
          <div className="flex-1">
            <p className="text-sm font-medium text-zinc-200">Upload Audio / Video</p>
            <p className="text-[11px] text-zinc-500 mt-0.5">
              Drag & drop atau klik • MP3, WAV, MP4, MKV, MOV, dll • Unlimited size & duration
            </p>
          </div>
        </div>
      </div>
    );
  }

  // Active state — show progress
  const videoIcon = isVideo(state.fileName);
  return (
    <div className="rounded-lg border border-white/[0.06] bg-white/[0.03] p-4 space-y-3">
      <input
        ref={fileInputRef}
        type="file"
        accept={[...ACCEPTED_FORMATS.audio, ...ACCEPTED_FORMATS.video].join(",")}
        onChange={onFileInputChange}
        className="hidden"
      />

      {/* File info */}
      <div className="flex items-center gap-3">
        <div className={cn(
          "flex h-10 w-10 items-center justify-center rounded-lg shrink-0",
          videoIcon ? "bg-sky-500/15" : "bg-emerald-500/15"
        )}>
          {videoIcon ? (
            <FileVideo className="h-5 w-5 text-sky-400" />
          ) : (
            <FileAudio className="h-5 w-5 text-emerald-400" />
          )}
        </div>
        <div className="flex-1 min-w-0">
          <p className="text-sm font-medium text-zinc-200 truncate">{state.fileName}</p>
          <p className="text-[11px] text-zinc-500">
            {formatSize(state.fileSize)}
            {state.status === "processing" && " • Transcribing..."}
            {state.status === "done" && " • Selesai"}
            {state.status === "error" && ` • Error: ${state.errorMsg}`}
          </p>
        </div>
        <div className="shrink-0">
          {state.status === "uploading" || state.status === "processing" ? (
            <Button
              size="sm"
              variant="ghost"
              onClick={cancelUpload}
              className="text-zinc-400 hover:text-red-400"
            >
              <X className="h-4 w-4" />
            </Button>
          ) : state.status === "done" ? (
            <CheckCircle2 className="h-5 w-5 text-emerald-400" />
          ) : state.status === "error" ? (
            <Button size="sm" variant="ghost" onClick={reset} className="text-zinc-400">
              <AlertCircle className="h-4 w-4" />
            </Button>
          ) : null}
        </div>
      </div>

      {/* Progress bar */}
      {(state.status === "uploading" || state.status === "processing") && (
        <div className="space-y-1">
          <Progress value={state.progress} className="h-1.5" />
          <div className="flex items-center justify-between text-[10px] text-zinc-500">
            <span>
              {state.status === "uploading" ? "Uploading..." : "Transcribing with large-v3-turbo..."}
            </span>
            <span>{Math.round(state.progress)}%</span>
          </div>
        </div>
      )}

      {/* Done — show restart button */}
      {state.status === "done" && (
        <Button size="sm" variant="outline" onClick={reset} className="w-full">
          <Upload className="h-3 w-3 mr-2" /> Upload File Lain
        </Button>
      )}

      {/* Error — retry button */}
      {state.status === "error" && (
        <Button size="sm" variant="outline" onClick={reset} className="w-full">
          <Upload className="h-3 w-3 mr-2" /> Coba Lagi
        </Button>
      )}
    </div>
  );
}
