---
interface Props {
  title?: string;
  showNavbar?: boolean;
}

const { title = 'ALYNNE AI', showNavbar = true } = Astro.props;
import Navbar from '@/components/Navbar.astro';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ALYNNE AI - One agent for all skills." />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
  </head>
  <body class="antialiased bg-background text-foreground">
    {showNavbar && <Navbar />}
    <slot />
  </body>
</html>
